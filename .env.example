
# =====================================
# NYC Taxi Data Engineering Pipeline
# Example Environment Configuration
# =====================================

# NYC Taxi PostgreSQL Warehouse
POSTGRES_USER=taxi_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=taxi_warehouse

# Airflow Metadata Database
AIRFLOW_DB_PASSWORD=replace_with_another_secure_password

# URL-encoded version of AIRFLOW_DB_PASSWORD
# If the password contains special URL characters,
# percent-encode them for the database connection URL.
AIRFLOW_DB_PASSWORD_ENCODED=replace_with_url_encoded_password

# Local dbt Connection
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
